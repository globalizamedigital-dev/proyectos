# LeadHunter Pro — Plantilla de configuración (.env.example)
#
# COPIA este archivo a ".env" en la raíz del proyecto y rellena los valores.
#   cp .env.example .env
#
# IMPORTANTE: el archivo ".env" REAL NUNCA debe subirse al repositorio.
#             Contiene credenciales. Ya está incluido en .gitignore.
#
# Orden de búsqueda del .env (el primero que exista se usa):
#   1) La ruta indicada en la variable de entorno LEADHUNTER_ENV
#   2) ./.env  (directorio de trabajo actual)
#   3) <raíz del proyecto>/.env
#   4) ~/.leadhunter.env

# --- Configuración SMTP (envío de email de outreach) ---

# Servidor SMTP. Gmail: smtp.gmail.com  |  Microsoft 365: smtp.office365.com
SMTP_HOST=smtp.gmail.com

# Puerto SMTP. 587 para STARTTLS, 465 para SSL.
SMTP_PORT=587

# Usuario de la cuenta SMTP (normalmente tu email completo).
SMTP_USER=tu-cuenta@gmail.com

# Contraseña SMTP. Para Gmail usa una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords), NO tu contraseña normal.
# Este valor es SECRETO: no lo compartas ni lo subas a ningún repositorio.
SMTP_PASSWORD=cambia-esto-por-tu-contraseña-de-aplicacion

# Dirección que aparece como remitente (From). Si se deja vacía, se usa SMTP_USER.
SMTP_FROM_EMAIL=tu-cuenta@gmail.com

# Nombre visible del remitente.
SMTP_FROM_NAME=LeadHunter Pro

# Usar STARTTLS (recomendado con el puerto 587). true / false.
SMTP_USE_TLS=true

# Usar SSL directo (necesario con el puerto 465). true / false.
SMTP_USE_SSL=false

# --- Límites de entregabilidad de email ---

# Segundos mínimos de espera entre envíos reales (throttle).
LEADHUNTER_MIN_SECONDS_BETWEEN_SENDS=45

# Número máximo de emails reales enviados por día (cap diario).
LEADHUNTER_DAILY_CAP=40

# --- Otros ajustes ---

# Directorio donde escribir las exportaciones (CSV/JSON). Opcional.
# Si se deja vacío, se usa ~/.cache/leadhunter-pro/<fecha>/
LEADHUNTER_OUTPUT_DIR=

# Identificador de sesión opcional para las observaciones (telemetría local).
# LEADHUNTER_SESSION_ID=
